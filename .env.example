# OpenMA Self-Host 环境变量完整清单
# 复制为 .env 后填写实际值：cp .env.example .env
# 所有真实密钥只放在未跟踪的 .env，不要提交到 Git。

# ─────────────────────────────────────────────────────────────
# 数据库
# ─────────────────────────────────────────────────────────────
# PostgreSQL Docker Compose 已在服务内部固定为：
# postgres://oma:oma@postgres:5432/oma
# 因此使用 docker-compose.postgres.yml 时不需要填写 DATABASE_URL。
# 如果直接运行 main-node 并连接外部 PostgreSQL，再取消注释并修改。
# DATABASE_URL=postgres://oma:oma@postgres:5432/oma

# 用户 Workspace、Files、Outputs、Backups 的统一根目录。
# Docker Compose 会覆盖为 /app/data；本机运行使用 ./data。
DATA_DIR=./data

# 仅 SQLite 模式使用；PostgreSQL 部署不读取。
# DATABASE_PATH=./data/oma.db
# AUTH_DATABASE_PATH=./data/auth.db

# ─────────────────────────────────────────────────────────────
# 认证与密钥
# ─────────────────────────────────────────────────────────────
# 必填：Better Auth Cookie/session 签名密钥。
BETTER_AUTH_SECRET=

# 必填：Model Card API Key 静态加密密钥。
PLATFORM_ROOT_SECRET=

# 生产/真实测试保持注释或留空；只有临时冒烟测试设置为 1。
# AUTH_DISABLED=1

# 浏览器实际访问地址；服务器部署时改成域名或 IP。
PUBLIC_BASE_URL=http://localhost:8787

# 可选：认证 Cookie 域名。
# AUTH_COOKIE_DOMAIN=example.com

# 当前运行时未单独读取，保留为文档项。
# AUTH_COOKIE_NAME=oma_session

# 当前 main-node 不读取全局 API_KEY；项目 SDK/旧部署示例可能使用。
# API_KEY=

# ─────────────────────────────────────────────────────────────
# 执行与服务
# ─────────────────────────────────────────────────────────────
# 唯一支持的执行后端：可信本地 subprocess，不是安全沙箱。
SANDBOX_PROVIDER=subprocess
HOST=0.0.0.0
PORT=8787
WORKER_MAX_ACTIVE=4
USER_MAX_ACTIVE=2
TURN_TIMEOUT_MS=0
LOG_LEVEL=info

# Docker 镜像会设置 NODE_ENV=production；本机开发不要强制设置。
# NODE_ENV=production

# Docker 镜像会设置为 /app/apps/console/dist；本机需要静态页面时填写。
# CONSOLE_DIR=./apps/console/dist

# ─────────────────────────────────────────────────────────────
# 模型凭据
# ─────────────────────────────────────────────────────────────
# 当前 main-node 禁用全局环境变量模型 fallback。
# 请在 Console 的 Model Cards 页面按用户配置 API Key。
# 不要把真实 API Key 放入 .env.example。
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=
# ANTHROPIC_MODEL=

# ─────────────────────────────────────────────────────────────
# 可选运维与观测
# ─────────────────────────────────────────────────────────────
# 设置后 /metrics 需要 Bearer Token。
# METRICS_BIND_TOKEN=

# 内部 Model Card API 调试入口 Token。
# INTERNAL_MODEL_CARD_TOKEN=

# 启用 OTLP tracing 时填写。
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_AUTO_INSTRUMENTATIONS=1

# ─────────────────────────────────────────────────────────────
# 非服务器配置：开发、Console 构建、测试专用
# ─────────────────────────────────────────────────────────────
# Console Vite 开发代理目标，默认 http://localhost:8787。
# VITE_API_TARGET=http://localhost:8787

# 项目 SDK 示例使用的客户端 API Key，不是服务端启动变量。
# OMA_API_KEY=

# PostgreSQL 集成测试专用。
# PG_TEST_URL=postgres://oma:oma@localhost:5432/oma

# 崩溃恢复测试专用。
# DEBUG_CRASH_RECOVERY=1
# OMA_TEST_STARTUP_TIMEOUT_MS=120000
