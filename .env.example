# Anthropic-compatible model provider. Model Cards may override this per tenant.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# Use DATABASE_URL for PostgreSQL; omit it to use local SQLite.
DATABASE_URL=
DATABASE_PATH=./data/oma.db
AUTH_DATABASE_PATH=./data/auth.db

# Required in authenticated deployments.
BETTER_AUTH_SECRET=
PLATFORM_ROOT_SECRET=
PUBLIC_BASE_URL=http://localhost:8787
# AUTH_DISABLED=1

# The only supported execution backend. It is trusted host subprocess execution,
# not a security sandbox.
SANDBOX_PROVIDER=subprocess
SANDBOX_WORKDIR=./data/sandboxes
FILES_BLOB_DIR=./data/files-blobs
SESSION_OUTPUTS_DIR=./data/session-outputs

HOST=0.0.0.0
PORT=8787
WORKER_MAX_ACTIVE=4
TENANT_MAX_ACTIVE=2
