{
  "name": "openma-self-host",
  "version": "0.1.0",
  "description": "Minimal Node self-host runtime for OpenMA.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "workspaces": ["packages/*", "apps/main-node", "apps/console"],
  "scripts": {
    "build": "pnpm typecheck && pnpm db:check",
    "dev": "pnpm --filter @open-managed-agents/main-node dev",
    "start": "pnpm --filter @open-managed-agents/main-node start",
    "typecheck": "pnpm run typecheck:node",
    "typecheck:node": "pnpm --filter @open-managed-agents/agent typecheck && pnpm --filter @open-managed-agents/sandbox typecheck && pnpm --filter @open-managed-agents/main-node typecheck",
    "test": "pnpm run test:packages",
    "test:packages": "pnpm --filter @open-managed-agents/session-runtime test && pnpm --filter @open-managed-agents/main-node test && pnpm --filter managed-agents-console test",
    "db:generate:node-pg": "drizzle-kit generate --config=drizzle.node-pg.config.ts",
    "db:generate:node-sqlite": "drizzle-kit generate --config=drizzle.node-sqlite.config.ts",
    "db:generate": "pnpm db:generate:node-pg && pnpm db:generate:node-sqlite",
    "db:check:node-pg": "drizzle-kit check --config=drizzle.node-pg.config.ts",
    "db:check:node-sqlite": "drizzle-kit check --config=drizzle.node-sqlite.config.ts",
    "db:check": "pnpm db:check:node-pg && pnpm db:check:node-sqlite"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "drizzle-kit": "^0.31.5",
    "typescript": "^5.8.0",
    "vitest": "^4.1.3"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.53",
    "drizzle-orm": "^0.45.2",
    "zod": "4.3.6"
  },
  "packageManager": "pnpm@11.0.8"
}
